set(TRIVIAL_CPU_X86_64_LEVEL v2)

function(trivial_apply_cpu_level)
	if(TRIVIAL_CPU_X86_64_LEVEL STREQUAL "v2")
		set(TRIVIAL_CPU_LEVEL 2)
		set(TRIVIAL_CPU_GNU_FLAGS -march=x86-64-v2)
		set(TRIVIAL_CPU_MSVC_FLAGS /arch:SSE4.2)
	elseif(TRIVIAL_CPU_X86_64_LEVEL STREQUAL "v3")
		set(TRIVIAL_CPU_LEVEL 3)
		set(TRIVIAL_CPU_GNU_FLAGS -march=x86-64-v3)
		set(TRIVIAL_CPU_MSVC_FLAGS /arch:AVX2)
	else()
		message(FATAL_ERROR "Unsupported x86-64 level: ${TRIVIAL_CPU_X86_64_LEVEL}")
	endif()

	if(MSVC AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
		list(TRANSFORM TRIVIAL_CPU_GNU_FLAGS PREPEND /clang:)
		target_compile_options(trivial PUBLIC ${TRIVIAL_CPU_GNU_FLAGS})
	elseif(MSVC)
		target_compile_options(trivial PUBLIC ${TRIVIAL_CPU_MSVC_FLAGS})
	else()
		target_compile_options(trivial PUBLIC ${TRIVIAL_CPU_GNU_FLAGS})
	endif()

	set(TRIVIAL_CPU_LEVEL_DEFINE "#define TRIVIAL_CPU_X86_64_LEVEL ${TRIVIAL_CPU_LEVEL}" PARENT_SCOPE)
endfunction()
