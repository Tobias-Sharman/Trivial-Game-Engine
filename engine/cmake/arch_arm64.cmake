set(TRIVIAL_CPU_ARM64_VERSION v8.0)

function(trivial_apply_cpu_version)
	if(TRIVIAL_CPU_ARM64_VERSION STREQUAL "v8.0")
		set(TRIVIAL_CPU_APPLE_M1 0)
		set(TRIVIAL_CPU_GNU_FLAGS -march=armv8-a -moutline-atomics)
		set(TRIVIAL_CPU_CLANG_CL_FLAGS /clang:-march=armv8-a)
		set(TRIVIAL_CPU_MSVC_FLAGS "")
	elseif(TRIVIAL_CPU_ARM64_VERSION STREQUAL "apple-m1")
		set(TRIVIAL_CPU_APPLE_M1 1)
		set(TRIVIAL_CPU_GNU_FLAGS -mcpu=apple-m1)
	else()
		message(FATAL_ERROR "Unsupported ARM64 version: ${TRIVIAL_CPU_ARM64_VERSION}")
	endif()

	if(MSVC AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
		target_compile_options(trivial PUBLIC ${TRIVIAL_CPU_CLANG_CL_FLAGS})
	elseif(MSVC)
		target_compile_options(trivial PUBLIC ${TRIVIAL_CPU_MSVC_FLAGS})
	else()
		target_compile_options(trivial PUBLIC ${TRIVIAL_CPU_GNU_FLAGS})
	endif()

	set(TRIVIAL_CPU_VERSION_DEFINE "#define TRIVIAL_CPU_ARM64_APPLE_M1 ${TRIVIAL_CPU_APPLE_M1}" PARENT_SCOPE)
endfunction()
