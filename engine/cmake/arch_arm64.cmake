set(TRIVIAL_CPU_ARM64_DEFAULT_VERSION v8.0)

function(trivial_apply_cpu_version)
	if(NOT DEFINED TRIVIAL_CPU_ARM64_VERSION)
		set(TRIVIAL_CPU_ARM64_VERSION ${TRIVIAL_CPU_ARM64_DEFAULT_VERSION})
	endif()

	if(TRIVIAL_CPU_ARM64_VERSION STREQUAL "v8.0")
		set(TRIVIAL_CPU_ARM64_APPLE_VERSION_NUMBER 0)
		set(TRIVIAL_CPU_GNU_FLAGS -march=armv8-a -moutline-atomics)
		set(TRIVIAL_CPU_CLANG_CL_FLAGS /clang:-march=armv8-a)
		set(TRIVIAL_CPU_MSVC_FLAGS "")
	elseif(TRIVIAL_CPU_ARM64_VERSION STREQUAL "apple-silicon")
		set(TRIVIAL_CPU_ARM64_APPLE_VERSION_NUMBER 1)
		if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
			set(TRIVIAL_CPU_GNU_FLAGS -march=armv8.5-a+aes+sha3+fp16fml -mtune=apple-m1)
		else()
			set(TRIVIAL_CPU_GNU_FLAGS -march=armv8.5-a+nobti+aes+sha3+fp16fml -mtune=apple-m1)
		endif()
	# elseif(TRIVIAL_CPU_ARM64_VERSION STREQUAL "apple-m2")
	# 	set(TRIVIAL_CPU_ARM64_APPLE_VERSION_NUMBER 2)
	# 	set(TRIVIAL_CPU_GNU_FLAGS -march=armv8.6-a+aes+sha3+fp16fml -mtune=apple-m2)
	# elseif(TRIVIAL_CPU_ARM64_VERSION STREQUAL "apple-m3")
	# 	set(TRIVIAL_CPU_ARM64_APPLE_VERSION_NUMBER 3)
	# 	set(TRIVIAL_CPU_GNU_FLAGS -march=armv8.6-a+aes+sha3+fp16fml -mtune=apple-m3)
	# elseif(TRIVIAL_CPU_ARM64_VERSION STREQUAL "apple-m4")
	# 	set(TRIVIAL_CPU_ARM64_APPLE_VERSION_NUMBER 4)
	# 	set(TRIVIAL_CPU_GNU_FLAGS -march=armv9.2-a+nosve+aes+sha3+fp16fml+sme2+sme-f64f64+sme-i16i64 -mtune=apple-m4)
	# elseif(TRIVIAL_CPU_ARM64_VERSION STREQUAL "apple-m5")
	# 	set(TRIVIAL_CPU_ARM64_APPLE_VERSION_NUMBER 5)
	# 	set(TRIVIAL_CPU_GNU_FLAGS
	# 	    -march=armv9.3-a+nosve+nomops+aes+sha3+fp16fml+sme2p1+sme-f64f64+sme-i16i64+sme-f16f16+cssc+memtag
	# 	    -mtune=apple-m5)
	else()
		message(FATAL_ERROR "Unsupported ARM64 version: ${TRIVIAL_CPU_ARM64_VERSION}")
	endif()

	if(MSVC AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
		target_compile_options(trivial PUBLIC ${TRIVIAL_CPU_CLANG_CL_FLAGS})
	elseif(MSVC)
		target_compile_options(trivial PUBLIC ${TRIVIAL_CPU_MSVC_FLAGS})
	else()
		target_compile_options(trivial PUBLIC ${TRIVIAL_CPU_GNU_FLAGS})
	endif()

	set(TRIVIAL_CPU_VERSION_DEFINE "#define TRIVIAL_CPU_ARM64_APPLE_VERSION ${TRIVIAL_CPU_ARM64_APPLE_VERSION_NUMBER}"
	    PARENT_SCOPE)
endfunction()
